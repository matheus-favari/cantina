generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Canteen {
  id                  String          @id @default(uuid())
  name                String
  logoUrl             String?
  themePrimaryColor   String?
  themeSecondaryColor String?
  segment             CanteenSegment
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  categories          Category[]
  orders              Order[]
  products            Product[]
  stockMovements      StockMovement[]
  users               User[]
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  passwordHash   String
  avatarUrl      String?
  role           UserRole        @default(EMPLOYEE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  canteenId      String
  createdOrders  Order[]
  stockMovements StockMovement[]
  canteen        Canteen         @relation(fields: [canteenId], references: [id])
}

model Category {
  id        String    @id @default(uuid())
  name      String
  imageUrl  String?
  canteenId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDefault Boolean   @default(false)
  canteen   Canteen   @relation(fields: [canteenId], references: [id])
  products  Product[]
}

model Product {
  id             String          @id @default(uuid())
  name           String
  price          Decimal
  stock          Int             @default(0)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  canteenId      String
  categoryId     String
  imageUrl       String?
  orderItems     OrderItem[]
  canteen        Canteen         @relation(fields: [canteenId], references: [id])
  category       Category        @relation(fields: [categoryId], references: [id])
  stockMovements StockMovement[]
}

model StockMovement {
  id        String            @id @default(uuid())
  quantity  Int
  type      StockMovementType
  reason    String?
  productId String
  createdAt DateTime          @default(now())
  canteenId String
  userId    String
  canteen   Canteen           @relation(fields: [canteenId], references: [id])
  product   Product           @relation(fields: [productId], references: [id])
  user      User              @relation(fields: [userId], references: [id])
}

model Order {
  id          String      @id @default(uuid())
  tableNumber Int
  total       Decimal     @default(0)
  status      OrderStatus @default(OPEN)
  openedAt    DateTime    @default(now())
  closedAt    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  canteenId   String
  userId      String
  canteen     Canteen     @relation(fields: [canteenId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  quantity  Int
  unitPrice Decimal
  subtotal  Decimal
  orderId   String
  productId String
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

enum CanteenSegment {
  ESCOLA
  RESTAURANTE
  PIZZARIA
  LANCHONETE
  PASTELARIA
  SALGADERIA
  PADARIA
  CONFEITARIA
  SORVETERIA
  BAR
  OUTRO
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELED
}

enum UserRole {
  ADMIN
  EMPLOYEE
  OWNER
}

enum StockMovementType {
  IN
  OUT
}
